# Supabase (Project Settings → API). Pick region Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Family PIN (use 6+ digits) and a long random secret for signing the login cookie
FAMILY_PIN=
AUTH_SECRET=

# Push reminders (npx web-push generate-vapid-keys) and the Vercel cron secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Helper login: their own PIN opens only the daily-care screen of this member.
HELPER_PIN=
HELPER_MEMBER_ID=

# Optional: Claude reads each upload and drafts its details (capped by SPEND_CAP_INR in src/lib/claude.ts)
ANTHROPIC_API_KEY=

# Optional: copy every upload to your Google Drive (then run: node scripts/drive-signin.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
